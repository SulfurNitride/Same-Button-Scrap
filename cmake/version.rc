#include <winver.h>

#define STRINGIFY_DETAIL(value) #value
#define STRINGIFY(value) STRINGIFY_DETAIL(value)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SWSB_VERSION_MAJOR,SWSB_VERSION_MINOR,SWSB_VERSION_PATCH,0
 PRODUCTVERSION SWSB_VERSION_MAJOR,SWSB_VERSION_MINOR,SWSB_VERSION_PATCH,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Scrap With Same Button contributors\0"
            VALUE "FileDescription", "Scrap With Same Button F4SE plugin\0"
            VALUE "FileVersion", SWSB_VERSION "\0"
            VALUE "InternalName", "ScrapWithSameButton\0"
            VALUE "LegalCopyright", "GPL-3.0-or-later\0"
            VALUE "OriginalFilename", "ScrapWithSameButton.dll\0"
            VALUE "ProductName", "Scrap With Same Button\0"
            VALUE "ProductVersion", SWSB_VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
